{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/bash-destructive-guard.sh",
            "timeout": 10,
            "statusMessage": "Checking for destructive patterns..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/sh-syntax-check.sh",
            "timeout": 10,
            "statusMessage": "bash -n on edited script..."
          }
        ]
      }
    ]
  }
}

# Runtime configuration ported from the original Unraid setup.
# This contains paths and service URLs only. Secrets are read from separate
# untracked files such as .lidarr-api-key and .ntfy-token.

MUSIC_PIPELINE_LOCALE=en_US.UTF-8
APP_ROOT=/mnt/user/appdata/scripts
TMP_DIR=/tmp

HOST_TORRENTS_ROOT=/mnt/user/Torrents
HOST_COMPLETE=/mnt/user/Torrents/complete
REVIEW_DIR=/mnt/user/Torrents/review
HOST_MEDIA_ROOT=/mnt/user/Media
MEDIA_DIR=/mnt/user/Media
MUSIC_HOST=/mnt/user/Media/Music

CONTAINER_DOWNLOADS_ROOT=/downloads
CONTAINER_MUSIC_ROOT=/music

BEETS_CONTAINER=beets
BEETS_USER=abc
TRANSMISSION_CONTAINER=transmission
TRANSMISSION_RPC_HOST=localhost
TRANSMISSION_RPC_USER=transmission
TRANSMISSION_PASSWORD_ENV=PASS

# Point at your Lidarr instance. Host-specific URLs (LAN IPs etc.) belong in
# config/music-pipeline.local, not in this tracked default.
LIDARR_URL=http://localhost:8686
NTFY_BASE_URL=http://localhost:2586
NTFY_TOPIC=music-pipeline

# Derived from APP_ROOT by lib/config.sh unless overridden in
# config/music-pipeline.local:
# - LIDARR_KEY_FILE
# - NTFY_TOKEN_FILE
# - LOG_DIR
# - BACKUP_ROOT
# - SYNC_NORM_AWK

BEETS_IMPORT_TIMEOUT=1800
BACKUP_RETENTION_DAYS=30
SKIP_LOCATION_PATTERNS='*/tv-sonarr*|*/radarr*|*/books*'
